IR:
; ModuleID = 'compiler_module'
source_filename = "compiler_module"
target datalayout = "e-p:64:64:64-i8:8-i16:16-i32:32-i64:64-f32:32-f64:64-f64:64-a:0:128-n8:16:32:64"

@__LDBL_MIN__ = internal global double 0.000000e+00, align 8
@NULL = internal global ptr null, align 8
@__FLT_MIN__ = internal global float 0.000000e+00, align 4
@__DBL_MIN__ = internal global double 0.000000e+00, align 8

define i32 @main() {
entry:
  %end = alloca ptr, align 8
  %begin = alloca ptr, align 8
  %values = alloca [8 x i64], align 8
  %arrayElemPtr = getelementptr [8 x i64], ptr %values, i64 0, i64 1
  store ptr %arrayElemPtr, ptr %begin, align 8
  %arrayElemPtr1 = getelementptr [8 x i64], ptr %values, i64 0, i64 6
  store ptr %arrayElemPtr1, ptr %end, align 8
  %end2 = load ptr, ptr %end, align 8
  %begin3 = load ptr, ptr %begin, align 8
  %0 = ptrtoint ptr %end2 to i64
  %1 = ptrtoint ptr %begin3 to i64
  %2 = sub i64 %0, %1
  %ptr.diff.bytes = sdiv exact i64 %2, ptrtoint (ptr getelementptr (i8, ptr null, i32 1) to i64)
  %ptr.diff = sdiv i64 %ptr.diff.bytes, 8
  %casttmp = trunc i64 %ptr.diff to i32
  ret i32 %casttmp
}
