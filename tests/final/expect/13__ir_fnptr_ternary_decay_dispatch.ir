IR:
; ModuleID = 'compiler_module'
source_filename = "compiler_module"
target datalayout = "e-p:64:64:64-i8:8-i16:16-i32:32-i64:64-f32:32-f64:64-f64:64-a:0:128-n8:16:32:64"

@__LDBL_MIN__ = internal global double 0.000000e+00, align 8
@NULL = internal global ptr null, align 8
@__FLT_MIN__ = internal global float 0.000000e+00, align 4
@__DBL_MIN__ = internal global double 0.000000e+00, align 8

define i32 @inc(i32 %0) {
entry:
  %x = alloca i32, align 4
  store i32 %0, ptr %x, align 4
  %x1 = load i32, ptr %x, align 4
  %addtmp = add i32 %x1, 1
  ret i32 %addtmp
}

define i32 @dec(i32 %0) {
entry:
  %x = alloca i32, align 4
  store i32 %0, ptr %x, align 4
  %x1 = load i32, ptr %x, align 4
  %subtmp = sub i32 %x1, 1
  ret i32 %subtmp
}

define i32 @main() {
entry:
  %fp = alloca ptr, align 8
  %pick = alloca i32, align 4
  store i32 1, ptr %pick, align 4
  %pick1 = load i32, ptr %pick, align 4
  %ternaryCond = icmp ne i32 %pick1, 0
  br i1 %ternaryCond, label %ternaryTrue, label %ternaryFalse

ternaryTrue:                                      ; preds = %entry
  br label %ternaryMerge

ternaryFalse:                                     ; preds = %entry
  br label %ternaryMerge

ternaryMerge:                                     ; preds = %ternaryFalse, %ternaryTrue
  %ternaryResult = phi ptr [ @inc, %ternaryTrue ], [ @dec, %ternaryFalse ]
  store ptr %ternaryResult, ptr %fp, align 8
  %fp2 = load ptr, ptr %fp, align 8
  %calltmp = call i32 %fp2(i32 4)
  %cmptmp = icmp ne i32 %calltmp, 5
  %cmp.int = zext i1 %cmptmp to i32
  ret i32 %cmp.int
}
