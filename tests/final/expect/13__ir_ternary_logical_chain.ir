IR:
; ModuleID = 'compiler_module'
source_filename = "compiler_module"
target datalayout = "e-p:64:64:64-i8:8-i16:16-i32:32-i64:64-f32:32-f64:64-f64:64-a:0:128-n8:16:32:64"

@__LDBL_MIN__ = internal global double 0.000000e+00, align 8
@NULL = internal global ptr null, align 8
@__FLT_MIN__ = internal global float 0.000000e+00, align 4
@__DBL_MIN__ = internal global double 0.000000e+00, align 8

define i32 @main() {
entry:
  %out = alloca i32, align 4
  %c = alloca i32, align 4
  %b = alloca i32, align 4
  %a = alloca i32, align 4
  store i32 0, ptr %a, align 4
  store i32 1, ptr %b, align 4
  store i32 2, ptr %c, align 4
  %a1 = load i32, ptr %a, align 4
  %ternaryCond = icmp ne i32 %a1, 0
  br i1 %ternaryCond, label %ternaryTrue, label %ternaryFalse

ternaryTrue:                                      ; preds = %entry
  %b2 = load i32, ptr %b, align 4
  %addtmp = add i32 %b2, 3
  br label %ternaryMerge

ternaryFalse:                                     ; preds = %entry
  %c3 = load i32, ptr %c, align 4
  %addtmp4 = add i32 %c3, 5
  br label %ternaryMerge

ternaryMerge:                                     ; preds = %ternaryFalse, %ternaryTrue
  %ternaryResult = phi i32 [ %addtmp, %ternaryTrue ], [ %addtmp4, %ternaryFalse ]
  %b5 = load i32, ptr %b, align 4
  %land.lhs = icmp ne i32 %b5, 0
  br i1 %land.lhs, label %land.rhs, label %land.end

land.rhs:                                         ; preds = %ternaryMerge
  %c6 = load i32, ptr %c, align 4
  %land.rhs.bool = icmp ne i32 %c6, 0
  br label %land.end

land.end:                                         ; preds = %land.rhs, %ternaryMerge
  %land.result = phi i1 [ false, %ternaryMerge ], [ %land.rhs.bool, %land.rhs ]
  %land.int = zext i1 %land.result to i32
  %ternaryCond7 = icmp ne i32 %land.int, 0
  br i1 %ternaryCond7, label %ternaryTrue8, label %ternaryFalse9

ternaryTrue8:                                     ; preds = %land.end
  br label %ternaryMerge10

ternaryFalse9:                                    ; preds = %land.end
  br label %ternaryMerge10

ternaryMerge10:                                   ; preds = %ternaryFalse9, %ternaryTrue8
  %ternaryResult11 = phi i32 [ 7, %ternaryTrue8 ], [ 9, %ternaryFalse9 ]
  %addtmp12 = add i32 %ternaryResult, %ternaryResult11
  store i32 %addtmp12, ptr %out, align 4
  %out13 = load i32, ptr %out, align 4
  ret i32 %out13
}
