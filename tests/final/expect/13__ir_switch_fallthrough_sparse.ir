IR:
; ModuleID = 'compiler_module'
source_filename = "compiler_module"
target datalayout = "e-p:64:64:64-i8:8-i16:16-i32:32-i64:64-f32:32-f64:64-f64:64-a:0:128-n8:16:32:64"

@__LDBL_MIN__ = internal global double 0.000000e+00, align 8
@NULL = internal global ptr null, align 8
@__FLT_MIN__ = internal global float 0.000000e+00, align 4
@__DBL_MIN__ = internal global double 0.000000e+00, align 8

define i32 @main() {
entry:
  %out = alloca i32, align 4
  %x = alloca i32, align 4
  store i32 2, ptr %x, align 4
  call void @llvm.memset.p0.i64(ptr align 4 %out, i8 0, i64 4, i1 false)
  %x1 = load i32, ptr %x, align 4
  switch i32 %x1, label %switch.default [
    i32 0, label %switch.case
    i32 1, label %switch.case2
    i32 2, label %switch.case3
  ]

switch.end:                                       ; preds = %switch.default, %switch.case2
  %out10 = load i32, ptr %out, align 4
  ret i32 %out10

switch.case:                                      ; preds = %entry
  %compound.load = load i32, ptr %out, align 4
  %compound.add = add i32 %compound.load, 1
  store i32 %compound.add, ptr %out, align 4
  br label %switch.case2

switch.case2:                                     ; preds = %switch.case, %entry
  %compound.load4 = load i32, ptr %out, align 4
  %compound.add5 = add i32 %compound.load4, 10
  store i32 %compound.add5, ptr %out, align 4
  br label %switch.end

switch.case3:                                     ; preds = %entry
  %compound.load6 = load i32, ptr %out, align 4
  %compound.add7 = add i32 %compound.load6, 100
  store i32 %compound.add7, ptr %out, align 4
  br label %switch.default

switch.default:                                   ; preds = %switch.case3, %entry
  %compound.load8 = load i32, ptr %out, align 4
  %compound.add9 = add i32 %compound.load8, 1000
  store i32 %compound.add9, ptr %out, align 4
  br label %switch.end
}

; Function Attrs: nocallback nofree nounwind willreturn memory(argmem: write)
declare void @llvm.memset.p0.i64(ptr writeonly captures(none) %0, i8 %1, i64 %2, i1 immarg %3) #0

attributes #0 = { nocallback nofree nounwind willreturn memory(argmem: write) }
