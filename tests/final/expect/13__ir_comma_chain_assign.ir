IR:
; ModuleID = 'compiler_module'
source_filename = "compiler_module"
target datalayout = "e-p:64:64:64-i8:8-i16:16-i32:32-i64:64-f32:32-f64:64-f64:64-a:0:128-n8:16:32:64"

@__LDBL_MIN__ = internal global double 0.000000e+00, align 8
@NULL = internal global ptr null, align 8
@__FLT_MIN__ = internal global float 0.000000e+00, align 4
@__DBL_MIN__ = internal global double 0.000000e+00, align 8

define i32 @main() {
entry:
  %out = alloca i32, align 4
  %z = alloca i32, align 4
  %y = alloca i32, align 4
  %x = alloca i32, align 4
  store i32 1, ptr %x, align 4
  store i32 2, ptr %y, align 4
  store i32 3, ptr %z, align 4
  %compound.load = load i32, ptr %x, align 4
  %compound.add = add i32 %compound.load, 2
  store i32 %compound.add, ptr %x, align 4
  %x1 = load i32, ptr %x, align 4
  %compound.load2 = load i32, ptr %y, align 4
  %compound.add3 = add i32 %compound.load2, %x1
  store i32 %compound.add3, ptr %y, align 4
  %y4 = load i32, ptr %y, align 4
  %compound.load5 = load i32, ptr %z, align 4
  %compound.add6 = add i32 %compound.load5, %y4
  store i32 %compound.add6, ptr %z, align 4
  store i32 %compound.add6, ptr %out, align 4
  %out7 = load i32, ptr %out, align 4
  %x8 = load i32, ptr %x, align 4
  %addtmp = add i32 %out7, %x8
  %y9 = load i32, ptr %y, align 4
  %addtmp10 = add i32 %addtmp, %y9
  %z11 = load i32, ptr %z, align 4
  %addtmp12 = add i32 %addtmp10, %z11
  ret i32 %addtmp12
}
