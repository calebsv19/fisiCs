IR:
; ModuleID = 'compiler_module'
source_filename = "compiler_module"
target datalayout = "e-p:64:64:64-i8:8-i16:16-i32:32-i64:64-f32:32-f64:64-f64:64-a:0:128-n8:16:32:64"

@__LDBL_MIN__ = internal global double 0.000000e+00, align 8
@NULL = internal global ptr null, align 8
@__FLT_MIN__ = internal global float 0.000000e+00, align 4
@__DBL_MIN__ = internal global double 0.000000e+00, align 8

define i32 @main() {
entry:
  %i = alloca i32, align 4
  %y = alloca i32, align 4
  %x = alloca i32, align 4
  call void @llvm.memset.p0.i64(ptr align 4 %x, i8 0, i64 4, i1 false)
  call void @llvm.memset.p0.i64(ptr align 4 %y, i8 0, i64 4, i1 false)
  call void @llvm.memset.p0.i64(ptr align 4 %i, i8 0, i64 4, i1 false)
  br label %forcond

forcond:                                          ; preds = %forinc, %entry
  %i1 = load i32, ptr %i, align 4
  %cmptmp = icmp slt i32 %i1, 8
  %cmp.int = zext i1 %cmptmp to i32
  %forcond2 = icmp ne i32 %cmp.int, 0
  br i1 %forcond2, label %forbody, label %forend

forbody:                                          ; preds = %forcond
  %i3 = load i32, ptr %i, align 4
  %andtmp = and i32 %i3, 1
  %cmptmp4 = icmp eq i32 %andtmp, 0
  %cmp.int5 = zext i1 %cmptmp4 to i32
  %ifcond = icmp ne i32 %cmp.int5, 0
  br i1 %ifcond, label %then, label %ifcont

forinc:                                           ; preds = %ifcont11, %then
  %unary.load = load i32, ptr %i, align 4
  %unary.inc = add i32 %unary.load, 1
  store i32 %unary.inc, ptr %i, align 4
  br label %forcond

forend:                                           ; preds = %then10, %forcond
  %x16 = load i32, ptr %x, align 4
  %y17 = load i32, ptr %y, align 4
  %addtmp = add i32 %x16, %y17
  ret i32 %addtmp

then:                                             ; preds = %forbody
  br label %forinc

ifcont:                                           ; preds = %forbody
  %i6 = load i32, ptr %i, align 4
  %cmptmp7 = icmp sgt i32 %i6, 5
  %cmp.int8 = zext i1 %cmptmp7 to i32
  %ifcond9 = icmp ne i32 %cmp.int8, 0
  br i1 %ifcond9, label %then10, label %ifcont11

then10:                                           ; preds = %ifcont
  br label %forend

ifcont11:                                         ; preds = %ifcont
  %i12 = load i32, ptr %i, align 4
  %compound.load = load i32, ptr %y, align 4
  %compound.add = add i32 %compound.load, %i12
  store i32 %compound.add, ptr %y, align 4
  %y13 = load i32, ptr %y, align 4
  %compound.load14 = load i32, ptr %x, align 4
  %compound.add15 = add i32 %compound.load14, %y13
  store i32 %compound.add15, ptr %x, align 4
  br label %forinc
}

; Function Attrs: nocallback nofree nounwind willreturn memory(argmem: write)
declare void @llvm.memset.p0.i64(ptr writeonly captures(none) %0, i8 %1, i64 %2, i1 immarg %3) #0

attributes #0 = { nocallback nofree nounwind willreturn memory(argmem: write) }
