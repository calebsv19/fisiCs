IR:
; ModuleID = 'compiler_module'
source_filename = "compiler_module"
target datalayout = "e-p:64:64:64-i8:8-i16:16-i32:32-i64:64-f32:32-f64:64-f64:64-a:0:128-n8:16:32:64"

%S = type { [3 x i32] }

@__LDBL_MIN__ = internal global double 0.000000e+00, align 8
@NULL = internal global ptr null, align 8
@__FLT_MIN__ = internal global float 0.000000e+00, align 4
@__DBL_MIN__ = internal global double 0.000000e+00, align 8

define i32 @main() {
entry:
  %s = alloca %S, align 4
  call void @llvm.memset.p0.i64(ptr align 4 %s, i8 0, i64 12, i1 false)
  %fieldPtr = getelementptr inbounds nuw %S, ptr %s, i32 0, i32 0
  call void @llvm.memset.p0.i64(ptr align 4 %fieldPtr, i8 0, i64 12, i1 false)
  %init.elem = getelementptr [3 x i32], ptr %fieldPtr, i32 0, i32 0
  store i32 1, ptr %init.elem, align 4
  %init.elem1 = getelementptr [3 x i32], ptr %fieldPtr, i32 0, i32 1
  store i32 2, ptr %init.elem1, align 4
  %init.elem2 = getelementptr [3 x i32], ptr %fieldPtr, i32 0, i32 2
  store i32 3, ptr %init.elem2, align 4
  %fieldPtr3 = getelementptr inbounds nuw %S, ptr %s, i32 0, i32 0
  %arrayElemPtr = getelementptr [3 x i32], ptr %fieldPtr3, i64 0, i64 2
  %arrayLoad = load i32, ptr %arrayElemPtr, align 4
  ret i32 %arrayLoad
}

; Function Attrs: nocallback nofree nounwind willreturn memory(argmem: write)
declare void @llvm.memset.p0.i64(ptr writeonly captures(none) %0, i8 %1, i64 %2, i1 immarg %3) #0

attributes #0 = { nocallback nofree nounwind willreturn memory(argmem: write) }
