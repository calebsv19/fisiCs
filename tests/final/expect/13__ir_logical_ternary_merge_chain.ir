IR:
; ModuleID = 'compiler_module'
source_filename = "compiler_module"
target datalayout = "e-p:64:64:64-i8:8-i16:16-i32:32-i64:64-f32:32-f64:64-f64:64-a:0:128-n8:16:32:64"

@__LDBL_MIN__ = internal global double 0.000000e+00, align 8
@NULL = internal global ptr null, align 8
@__FLT_MIN__ = internal global float 0.000000e+00, align 4
@__DBL_MIN__ = internal global double 0.000000e+00, align 8

define i32 @main() {
entry:
  %z = alloca i32, align 4
  %y = alloca i32, align 4
  %x = alloca i32, align 4
  store i32 1, ptr %x, align 4
  store i32 2, ptr %y, align 4
  store i32 0, ptr %z, align 4
  %x1 = load i32, ptr %x, align 4
  %y2 = load i32, ptr %y, align 4
  %cmptmp = icmp slt i32 %x1, %y2
  %cmp.int = zext i1 %cmptmp to i32
  %ternaryCond = icmp ne i32 %cmp.int, 0
  br i1 %ternaryCond, label %ternaryTrue, label %ternaryFalse

ternaryTrue:                                      ; preds = %entry
  %x3 = load i32, ptr %x, align 4
  %y4 = load i32, ptr %y, align 4
  %addtmp = add i32 %x3, %y4
  br label %ternaryMerge

ternaryFalse:                                     ; preds = %entry
  %x5 = load i32, ptr %x, align 4
  %y6 = load i32, ptr %y, align 4
  %subtmp = sub i32 %x5, %y6
  br label %ternaryMerge

ternaryMerge:                                     ; preds = %ternaryFalse, %ternaryTrue
  %ternaryResult = phi i32 [ %addtmp, %ternaryTrue ], [ %subtmp, %ternaryFalse ]
  store i32 %ternaryResult, ptr %z, align 4
  %x7 = load i32, ptr %x, align 4
  %land.lhs = icmp ne i32 %x7, 0
  br i1 %land.lhs, label %land.rhs, label %land.end

land.rhs:                                         ; preds = %ternaryMerge
  %y8 = load i32, ptr %y, align 4
  %land.rhs.bool = icmp ne i32 %y8, 0
  br label %land.end

land.end:                                         ; preds = %land.rhs, %ternaryMerge
  %land.result = phi i1 [ false, %ternaryMerge ], [ %land.rhs.bool, %land.rhs ]
  %land.int = zext i1 %land.result to i32
  %ternaryCond9 = icmp ne i32 %land.int, 0
  br i1 %ternaryCond9, label %ternaryTrue10, label %ternaryFalse11

ternaryTrue10:                                    ; preds = %land.end
  br label %ternaryMerge12

ternaryFalse11:                                   ; preds = %land.end
  br label %ternaryMerge12

ternaryMerge12:                                   ; preds = %ternaryFalse11, %ternaryTrue10
  %ternaryResult13 = phi i32 [ 3, %ternaryTrue10 ], [ 4, %ternaryFalse11 ]
  %compound.load = load i32, ptr %z, align 4
  %compound.add = add i32 %compound.load, %ternaryResult13
  store i32 %compound.add, ptr %z, align 4
  %z14 = load i32, ptr %z, align 4
  ret i32 %z14
}
