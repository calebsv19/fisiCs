IR:
; ModuleID = 'compiler_module'
source_filename = "compiler_module"
target datalayout = "e-p:64:64:64-i8:8-i16:16-i32:32-i64:64-f32:32-f64:64-f64:64-a:0:128-n8:16:32:64"

@__LDBL_MIN__ = internal global double 0.000000e+00, align 8
@NULL = internal global ptr null, align 8
@__FLT_MIN__ = internal global float 0.000000e+00, align 4
@__DBL_MIN__ = internal global double 0.000000e+00, align 8

define i32 @main() {
entry:
  %out = alloca i32, align 4
  %y = alloca i32, align 4
  %x = alloca i32, align 4
  store i32 0, ptr %x, align 4
  store i32 2, ptr %y, align 4
  store i32 0, ptr %out, align 4
  %x1 = load i32, ptr %x, align 4
  switch i32 %x1, label %switch.default [
    i32 0, label %switch.case
  ]

switch.end:                                       ; preds = %switch.default, %switch.end3
  %out7 = load i32, ptr %out, align 4
  ret i32 %out7

switch.case:                                      ; preds = %entry
  %y2 = load i32, ptr %y, align 4
  switch i32 %y2, label %switch.default6 [
    i32 1, label %switch.case4
    i32 2, label %switch.case5
  ]

switch.default:                                   ; preds = %entry
  store i32 44, ptr %out, align 4
  br label %switch.end

switch.end3:                                      ; preds = %switch.default6, %switch.case5, %switch.case4
  br label %switch.end

switch.case4:                                     ; preds = %switch.case
  store i32 11, ptr %out, align 4
  br label %switch.end3

switch.case5:                                     ; preds = %switch.case
  store i32 22, ptr %out, align 4
  br label %switch.end3

switch.default6:                                  ; preds = %switch.case
  store i32 33, ptr %out, align 4
  br label %switch.end3
}
