IR:
; ModuleID = 'compiler_module'
source_filename = "compiler_module"
target datalayout = "e-p:64:64:64-i8:8-i16:16-i32:32-i64:64-f32:32-f64:64-f64:64-a:0:128-n8:16:32:64"

@__LDBL_MIN__ = internal global double 0.000000e+00, align 8
@NULL = internal global ptr null, align 8
@__FLT_MIN__ = internal global float 0.000000e+00, align 4
@__DBL_MIN__ = internal global double 0.000000e+00, align 8

define i32 @main() {
entry:
  %acc = alloca i32, align 4
  %i = alloca i32, align 4
  call void @llvm.memset.p0.i64(ptr align 4 %i, i8 0, i64 4, i1 false)
  call void @llvm.memset.p0.i64(ptr align 4 %acc, i8 0, i64 4, i1 false)
  br label %loopbody

loopcond:                                         ; preds = %ifcont7, %then
  %i9 = load i32, ptr %i, align 4
  %cmptmp10 = icmp slt i32 %i9, 8
  %cmp.int11 = zext i1 %cmptmp10 to i32
  %loopcond12 = icmp ne i32 %cmp.int11, 0
  br i1 %loopcond12, label %loopbody, label %loopend

loopbody:                                         ; preds = %loopcond, %entry
  %unary.load = load i32, ptr %i, align 4
  %unary.inc = add i32 %unary.load, 1
  store i32 %unary.inc, ptr %i, align 4
  %i1 = load i32, ptr %i, align 4
  %cmptmp = icmp eq i32 %i1, 2
  %cmp.int = zext i1 %cmptmp to i32
  %ifcond = icmp ne i32 %cmp.int, 0
  br i1 %ifcond, label %then, label %ifcont

loopend:                                          ; preds = %loopcond, %then6
  %acc13 = load i32, ptr %acc, align 4
  ret i32 %acc13

then:                                             ; preds = %loopbody
  br label %loopcond

ifcont:                                           ; preds = %loopbody
  %i2 = load i32, ptr %i, align 4
  %cmptmp3 = icmp eq i32 %i2, 5
  %cmp.int4 = zext i1 %cmptmp3 to i32
  %ifcond5 = icmp ne i32 %cmp.int4, 0
  br i1 %ifcond5, label %then6, label %ifcont7

then6:                                            ; preds = %ifcont
  br label %loopend

ifcont7:                                          ; preds = %ifcont
  %i8 = load i32, ptr %i, align 4
  %compound.load = load i32, ptr %acc, align 4
  %compound.add = add i32 %compound.load, %i8
  store i32 %compound.add, ptr %acc, align 4
  br label %loopcond
}

; Function Attrs: nocallback nofree nounwind willreturn memory(argmem: write)
declare void @llvm.memset.p0.i64(ptr writeonly captures(none) %0, i8 %1, i64 %2, i1 immarg %3) #0

attributes #0 = { nocallback nofree nounwind willreturn memory(argmem: write) }
