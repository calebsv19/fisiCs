IR:
; ModuleID = 'compiler_module'
source_filename = "compiler_module"
target datalayout = "e-p:64:64:64-i8:8-i16:16-i32:32-i64:64-f32:32-f64:64-f64:64-a:0:128-n8:16:32:64"

@__LDBL_MIN__ = internal global double 0.000000e+00, align 8
@NULL = internal global ptr null, align 8
@__FLT_MIN__ = internal global float 0.000000e+00, align 4
@__DBL_MIN__ = internal global double 0.000000e+00, align 8

define i32 @main() {
entry:
  %p = alloca ptr, align 8
  %arr = alloca [2 x i32], align 4
  call void @llvm.memset.p0.i64(ptr align 4 %arr, i8 0, i64 8, i1 false)
  %init.elem = getelementptr [2 x i32], ptr %arr, i32 0, i32 0
  store i32 1, ptr %init.elem, align 4
  %init.elem1 = getelementptr [2 x i32], ptr %arr, i32 0, i32 1
  store i32 2, ptr %init.elem1, align 4
  store ptr %arr, ptr %p, align 8
  %p2 = load ptr, ptr %p, align 8
  %ptr.cmp.lhs = ptrtoint ptr %p2 to i64
  %ptrcmp = icmp ne i64 %ptr.cmp.lhs, 0
  %ptrcmp.int = zext i1 %ptrcmp to i32
  %ternaryCond = icmp ne i32 %ptrcmp.int, 0
  br i1 %ternaryCond, label %ternaryTrue, label %ternaryFalse

ternaryTrue:                                      ; preds = %entry
  %array.ptr.load = load ptr, ptr %p, align 8
  %arrayElemPtr = getelementptr i32, ptr %array.ptr.load, i64 1
  %arrayLoad = load i32, ptr %arrayElemPtr, align 4
  br label %ternaryMerge

ternaryFalse:                                     ; preds = %entry
  br label %ternaryMerge

ternaryMerge:                                     ; preds = %ternaryFalse, %ternaryTrue
  %ternaryResult = phi i32 [ %arrayLoad, %ternaryTrue ], [ 0, %ternaryFalse ]
  ret i32 %ternaryResult
}

; Function Attrs: nocallback nofree nounwind willreturn memory(argmem: write)
declare void @llvm.memset.p0.i64(ptr nocapture writeonly %0, i8 %1, i64 %2, i1 immarg %3) #0

attributes #0 = { nocallback nofree nounwind willreturn memory(argmem: write) }
