IR:
; ModuleID = 'compiler_module'
source_filename = "compiler_module"
target datalayout = "e-p:64:64:64-i8:8-i16:16-i32:32-i64:64-f32:32-f64:64-f64:64-a:0:128-n8:16:32:64"

%Word = type { i32 }

@__LDBL_MIN__ = internal global double 0.000000e+00, align 8
@NULL = internal global ptr null, align 8
@__FLT_MIN__ = internal global float 0.000000e+00, align 4
@__DBL_MIN__ = internal global double 0.000000e+00, align 8

define internal i64 @step(i64 %0) {
entry:
  %ret.abi.unpack.slot = alloca %Word, align 16
  %w = alloca %Word, align 16
  store %Word zeroinitializer, ptr %ret.abi.unpack.slot, align 4
  store i64 %0, ptr %ret.abi.unpack.slot, align 8
  %param.abi.unpack = load %Word, ptr %ret.abi.unpack.slot, align 4
  store %Word %param.abi.unpack, ptr %w, align 4
  %fieldPtr = getelementptr inbounds nuw %Word, ptr %w, i32 0, i32 0
  %compound.load = load i32, ptr %fieldPtr, align 4
  %compound.add = add i32 %compound.load, 3
  store i32 %compound.add, ptr %fieldPtr, align 4
  %w1 = load i64, ptr %w, align 8
  ret i64 %w1
}

define i32 @main() {
entry:
  %agg.tmp = alloca %Word, align 16
  %ret.abi.unpack.slot = alloca %Word, align 16
  %call.extabi.pack.slot = alloca i64, align 8
  %w = alloca %Word, align 4
  %fieldPtr = getelementptr inbounds nuw %Word, ptr %w, i32 0, i32 0
  store i32 10, ptr %fieldPtr, align 4
  %w1 = load %Word, ptr %w, align 4
  store i64 0, ptr %call.extabi.pack.slot, align 8
  store %Word %w1, ptr %call.extabi.pack.slot, align 4
  %call.arg.pack = load i64, ptr %call.extabi.pack.slot, align 8
  %calltmp = call i64 @step(i64 %call.arg.pack)
  store %Word zeroinitializer, ptr %ret.abi.unpack.slot, align 4
  store i64 %calltmp, ptr %ret.abi.unpack.slot, align 8
  %call.abi.unpack = load %Word, ptr %ret.abi.unpack.slot, align 4
  store %Word %call.abi.unpack, ptr %agg.tmp, align 4
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %w, ptr align 4 %agg.tmp, i64 4, i1 false)
  %fieldPtr2 = getelementptr inbounds nuw %Word, ptr %w, i32 0, i32 0
  %dot_field = load i32, ptr %fieldPtr2, align 4
  ret i32 %dot_field
}

; Function Attrs: nocallback nofree nounwind willreturn memory(argmem: readwrite)
declare void @llvm.memcpy.p0.p0.i64(ptr noalias nocapture writeonly %0, ptr noalias nocapture readonly %1, i64 %2, i1 immarg %3) #0

attributes #0 = { nocallback nofree nounwind willreturn memory(argmem: readwrite) }
