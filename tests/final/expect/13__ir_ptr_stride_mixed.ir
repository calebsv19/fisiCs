IR:
; ModuleID = 'compiler_module'
source_filename = "compiler_module"
target datalayout = "e-p:64:64:64-i8:8-i16:16-i32:32-i64:64-f32:32-f64:64-f64:64-a:0:128-n8:16:32:64"

@__LDBL_MIN__ = internal global double 0.000000e+00, align 8
@NULL = internal global ptr null, align 8
@__FLT_MIN__ = internal global float 0.000000e+00, align 4
@__DBL_MIN__ = internal global double 0.000000e+00, align 8

define i32 @main() {
entry:
  %ql = alloca ptr, align 8
  %pl = alloca ptr, align 8
  %longs = alloca [8 x i64], align 8
  %qi = alloca ptr, align 8
  %pi = alloca ptr, align 8
  %ints = alloca [8 x i32], align 4
  %arrayElemPtr = getelementptr [8 x i32], ptr %ints, i64 0, i64 1
  store ptr %arrayElemPtr, ptr %pi, align 8
  %arrayElemPtr1 = getelementptr [8 x i32], ptr %ints, i64 0, i64 6
  store ptr %arrayElemPtr1, ptr %qi, align 8
  %arrayElemPtr2 = getelementptr [8 x i64], ptr %longs, i64 0, i64 2
  store ptr %arrayElemPtr2, ptr %pl, align 8
  %arrayElemPtr3 = getelementptr [8 x i64], ptr %longs, i64 0, i64 7
  store ptr %arrayElemPtr3, ptr %ql, align 8
  %qi4 = load ptr, ptr %qi, align 8
  %pi5 = load ptr, ptr %pi, align 8
  %0 = ptrtoint ptr %qi4 to i64
  %1 = ptrtoint ptr %pi5 to i64
  %2 = sub i64 %0, %1
  %ptr.diff.bytes = sdiv exact i64 %2, ptrtoint (ptr getelementptr (i8, ptr null, i32 1) to i64)
  %ptr.diff = sdiv i64 %ptr.diff.bytes, 4
  %multmp = mul i64 %ptr.diff, 10
  %ql6 = load ptr, ptr %ql, align 8
  %pl7 = load ptr, ptr %pl, align 8
  %3 = ptrtoint ptr %ql6 to i64
  %4 = ptrtoint ptr %pl7 to i64
  %5 = sub i64 %3, %4
  %ptr.diff.bytes8 = sdiv exact i64 %5, ptrtoint (ptr getelementptr (i8, ptr null, i32 1) to i64)
  %ptr.diff9 = sdiv i64 %ptr.diff.bytes8, 8
  %addtmp = add i64 %multmp, %ptr.diff9
  %casttmp = trunc i64 %addtmp to i32
  ret i32 %casttmp
}
