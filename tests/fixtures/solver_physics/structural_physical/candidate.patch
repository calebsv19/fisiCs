+/* Internal physical carriers for admitted SI planar Euler-Bernoulli members.
+ * No public ABI, model admission, reference-frame identity or whole-solver claim.
+ * Typed arithmetic is separate from explicit raw SI restoration below. */
+#ifndef CORE_STRUCTURAL_FRAME_PHYSICAL_H
+#define CORE_STRUCTURAL_FRAME_PHYSICAL_H
+#ifdef __FISICS__
+#include <fisics/extensions.h>
+#define CS_PHYSICAL_DIM(v) FISICS_DIM(v)
+#define CS_PHYSICAL_UNIT(v) FISICS_UNIT(v)
+#else
+#define CS_PHYSICAL_DIM(v)
+#define CS_PHYSICAL_UNIT(v)
+#endif
+
+typedef struct CsPhysicalSection {
+    double young CS_PHYSICAL_DIM(pressure) CS_PHYSICAL_UNIT(pascal);
+    double area CS_PHYSICAL_DIM(area) CS_PHYSICAL_UNIT(square_meter);
+    double inertia CS_PHYSICAL_DIM(second_moment_of_area) CS_PHYSICAL_UNIT(meter_to_fourth);
+    double length CS_PHYSICAL_DIM(length) CS_PHYSICAL_UNIT(meter);
+} CsPhysicalSection;
+
+typedef struct CsPhysicalStiffness {
+    double axial CS_PHYSICAL_DIM(force/length);
+    double bending CS_PHYSICAL_DIM(force/length);
+    double tt[4][4] CS_PHYSICAL_DIM(force/length);
+    double tr[4][2] CS_PHYSICAL_DIM(force);
+    double rt[2][4] CS_PHYSICAL_DIM(force);
+    double rr[2][2] CS_PHYSICAL_DIM(force*length);
+} CsPhysicalStiffness;
+
+typedef struct CsPhysicalCoordinates {
+    double translation[4] CS_PHYSICAL_DIM(length) CS_PHYSICAL_UNIT(meter);
+    double rotation[2] CS_PHYSICAL_DIM(scalar);
+} CsPhysicalCoordinates;
+
+typedef struct CsPhysicalLoads {
+    double force[4] CS_PHYSICAL_DIM(force);
+    double moment[2] CS_PHYSICAL_DIM(force*length);
+} CsPhysicalLoads;
+
+static inline void cs_physical_build(const CsPhysicalSection *section, CsPhysicalStiffness *k) {
+    double axial CS_PHYSICAL_DIM(force/length) = section->young * section->area / section->length;
+    double bending CS_PHYSICAL_DIM(force/length) = section->young * section->inertia /
+        (section->length * section->length * section->length);
+    k->axial = axial;
+    k->bending = bending;
+    double transverse CS_PHYSICAL_DIM(force/length) = 12 * bending;
+    double coupling CS_PHYSICAL_DIM(force) = 6 * bending * section->length;
+    double rotation_diagonal CS_PHYSICAL_DIM(force*length) = 4 * bending * section->length * section->length;
+    double rotation_off_diagonal CS_PHYSICAL_DIM(force*length) = 2 * bending * section->length * section->length;
+    double zero_tt CS_PHYSICAL_DIM(force/length) = 0;
+    double zero_coupling CS_PHYSICAL_DIM(force) = 0;
+    for (unsigned i = 0; i < 4; ++i) {
+        for (unsigned j = 0; j < 4; ++j) k->tt[i][j] = zero_tt;
+        for (unsigned j = 0; j < 2; ++j) k->tr[i][j] = zero_coupling;
+    }
+    for (unsigned i = 0; i < 2; ++i)
+        for (unsigned j = 0; j < 4; ++j) k->rt[i][j] = zero_coupling;
+    k->tt[0][0] = axial;
+    k->tt[0][2] = -axial;
+    k->tt[2][0] = -axial;
+    k->tt[2][2] = axial;
+    k->tt[1][1] = transverse;
+    k->tt[1][3] = -transverse;
+    k->tt[3][1] = -transverse;
+    k->tt[3][3] = transverse;
+    k->tr[1][0] = coupling;
+    k->tr[1][1] = coupling;
+    k->tr[3][0] = -coupling;
+    k->tr[3][1] = -coupling;
+    k->rt[0][1] = coupling;
+    k->rt[0][3] = -coupling;
+    k->rt[1][1] = coupling;
+    k->rt[1][3] = -coupling;
+    k->rr[0][0] = rotation_diagonal;
+    k->rr[0][1] = rotation_off_diagonal;
+    k->rr[1][0] = rotation_off_diagonal;
+    k->rr[1][1] = rotation_diagonal;
+}
+
+static inline void cs_physical_apply(const CsPhysicalStiffness *k,
+    const CsPhysicalCoordinates *q, CsPhysicalLoads *load) {
+    double zero_force CS_PHYSICAL_DIM(force) = 0;
+    double zero_moment CS_PHYSICAL_DIM(force*length) = 0;
+    for (unsigned i = 0; i < 4; ++i) {
+        load->force[i] = zero_force;
+        load->force[i] += k->tt[i][0] * q->translation[0];
+        load->force[i] += k->tt[i][1] * q->translation[1];
+        load->force[i] += k->tr[i][0] * q->rotation[0];
+        load->force[i] += k->tt[i][2] * q->translation[2];
+        load->force[i] += k->tt[i][3] * q->translation[3];
+        load->force[i] += k->tr[i][1] * q->rotation[1];
+    }
+    for (unsigned i = 0; i < 2; ++i) {
+        load->moment[i] = zero_moment;
+        load->moment[i] += k->rt[i][0] * q->translation[0];
+        load->moment[i] += k->rt[i][1] * q->translation[1];
+        load->moment[i] += k->rr[i][0] * q->rotation[0];
+        load->moment[i] += k->rt[i][2] * q->translation[2];
+        load->moment[i] += k->rt[i][3] * q->translation[3];
+        load->moment[i] += k->rr[i][1] * q->rotation[1];
+    }
+}
+
+typedef struct CsPhysicalLineLoad {
+    double x CS_PHYSICAL_DIM(force/length);
+    double y CS_PHYSICAL_DIM(force/length);
+    double length CS_PHYSICAL_DIM(length) CS_PHYSICAL_UNIT(meter);
+} CsPhysicalLineLoad;
+static inline void cs_physical_equivalent_load(const CsPhysicalLineLoad *q, CsPhysicalLoads *out) {
+    out->force[0] = q->x*q->length/2;
+    out->force[1] = q->y*q->length/2;
+    out->force[2] = out->force[0];
+    out->force[3] = out->force[1];
+    out->moment[0] = q->y*q->length*q->length/12;
+    out->moment[1] = -out->moment[0];
+}
+/* Subtraction stays before accumulation to preserve original recovery order. */
+static inline void cs_physical_recover_end(const CsPhysicalStiffness *k,
+    const CsPhysicalCoordinates *q, const CsPhysicalLoads *equivalent, CsPhysicalLoads *out) {
+    for (unsigned i=0;i<4;++i) {
+        out->force[i] = -equivalent->force[i];
+        out->force[i] += k->tt[i][0]*q->translation[0];
+        out->force[i] += k->tt[i][1]*q->translation[1];
+        out->force[i] += k->tr[i][0]*q->rotation[0];
+        out->force[i] += k->tt[i][2]*q->translation[2];
+        out->force[i] += k->tt[i][3]*q->translation[3];
+        out->force[i] += k->tr[i][1]*q->rotation[1];
+    }
+    for (unsigned i=0;i<2;++i) {
+        out->moment[i] = -equivalent->moment[i];
+        out->moment[i] += k->rt[i][0]*q->translation[0];
+        out->moment[i] += k->rt[i][1]*q->translation[1];
+        out->moment[i] += k->rr[i][0]*q->rotation[0];
+        out->moment[i] += k->rt[i][2]*q->translation[2];
+        out->moment[i] += k->rt[i][3]*q->translation[3];
+        out->moment[i] += k->rr[i][1]*q->rotation[1];
+    }
+}
+/* Public heterogeneous arrays carry no per-slot units. These adapters explicitly
+ * assert admitted SI and the legacy six-DOF order; strict reports MUST refuse
+ * restoration. They are audited trust, not inferred metadata or conversions. */
+static inline void cs_physical_dense_pack(const CsPhysicalStiffness *k, double out[6][6]) {
+    const unsigned t[4]={0,1,3,4}, r[2]={2,5};
+    for(unsigned i=0;i<4;++i)for(unsigned j=0;j<4;++j)out[t[i]][t[j]]=k->tt[i][j];
+    for(unsigned i=0;i<4;++i)for(unsigned j=0;j<2;++j)out[t[i]][r[j]]=k->tr[i][j];
+    for(unsigned i=0;i<2;++i)for(unsigned j=0;j<4;++j)out[r[i]][t[j]]=k->rt[i][j];
+    for(unsigned i=0;i<2;++i)for(unsigned j=0;j<2;++j)out[r[i]][r[j]]=k->rr[i][j];
+}
+static inline void cs_physical_dense_restore_assumed_si(const double in[36], CsPhysicalStiffness *k) {
+    const unsigned t[4]={0,1,3,4}, r[2]={2,5};
+    for(unsigned i=0;i<4;++i)for(unsigned j=0;j<4;++j)k->tt[i][j]=in[t[i]*6+t[j]];
+    for(unsigned i=0;i<4;++i)for(unsigned j=0;j<2;++j)k->tr[i][j]=in[t[i]*6+r[j]];
+    for(unsigned i=0;i<2;++i)for(unsigned j=0;j<4;++j)k->rt[i][j]=in[r[i]*6+t[j]];
+    for(unsigned i=0;i<2;++i)for(unsigned j=0;j<2;++j)k->rr[i][j]=in[r[i]*6+r[j]];
+}
+static inline void cs_physical_coordinates_restore_assumed_si(const double in[6], CsPhysicalCoordinates *q) {
+    q->translation[0]=in[0];q->translation[1]=in[1];q->rotation[0]=in[2];
+    q->translation[2]=in[3];q->translation[3]=in[4];q->rotation[1]=in[5];
+}
+static inline void cs_physical_loads_restore_assumed_si(const double in[6], CsPhysicalLoads *p) {
+    p->force[0]=in[0];p->force[1]=in[1];p->moment[0]=in[2];
+    p->force[2]=in[3];p->force[3]=in[4];p->moment[1]=in[5];
+}
+static inline void cs_physical_loads_pack(const CsPhysicalLoads *p, double out[6]) {
+    out[0]=p->force[0];out[1]=p->force[1];out[2]=p->moment[0];
+    out[3]=p->force[2];out[4]=p->force[3];out[5]=p->moment[1];
+}
+#endif
