    "id": "consumer-before-kinematics",
    "tu": "core_structural_frame_motion_integrate",
    "old": " for(size_t i=0;i<n;i++){o->accepted.acceleration[i]=4/(dt*dt)*(w->result.displacement[i]-v.predictor[i]);o->accepted.velocity[i]=v.velocity_predictor[i]+dt*.5*o->accepted.acceleration[i];external+=cs_de_work((unsigned)i,endpoint_load!=NULL,old.frame.state.applied[i],t.load[i],old.frame.state.displacement[i],w->result.displacement[i]);}\n w->result.residual_n=w->result.residual_nm=0;\n for(size_t i=0;i<n;i++){o->accepted.inertial[i]=o->accepted.damping[i]=0;double residual=w->result.internal[i]-t.load[i];for(size_t j=0;j<n;j++){kinetic+=cs_de_kinetic((unsigned)i,(unsigned)j,o->accepted.velocity[i],o->mass[i][j],o->accepted.velocity[j]);damping+=cs_de_damping((unsigned)i,(unsigned)j,dt,o->settings.alpha_m_per_s,old.velocity[i],o->accepted.velocity[i],o->mass[i][j],old.velocity[j],o->accepted.velocity[j]);o->accepted.inertial[i]+=o->mass[i][j]*o->accepted.acceleration[j];o->accepted.damping[i]+=o->mass[i][j]*o->settings.alpha_m_per_s*o->accepted.velocity[j];residual+=o->mass[i][j]*(o->accepted.acceleration[j]+o->settings.alpha_m_per_s*o->accepted.velocity[j]);}if(m->fixed[i])w->result.reaction[i]=residual;else if(i%3==2)w->result.residual_nm=fmax(w->result.residual_nm,fabs(residual));else w->result.residual_n=fmax(w->result.residual_n,fabs(residual));}\n",
